{
  "expo": {
    "name": "Pulse Sound",
    "slug": "pulse-sound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070810",
    "splash": {
      "backgroundColor": "#070810",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotify.mobileapp",
      "backgroundColor": "#070810"
    },
    "android": {
      "package": "com.spotify.mobileapp",
      "backgroundColor": "#070810",
      "adaptiveIcon": {
        "backgroundColor": "#090A0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "SYSTEM_ALERT_WINDOW",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withPulseOverlay.js",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070810",
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Pulse Sound to save audio files to your device.",
          "savePhotosPermission": "Allow Pulse Sound to save audio files to your device."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3d4058a3-06dd-472f-a07b-2c624f975c1c"
      }
    },
    "owner": "vedant_79"
  }
}
